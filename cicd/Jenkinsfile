pipeline {
    agent any

    environment {
        // Elasticsearch credentials (configure in Jenkins)
        ELASTIC_CLOUD_ENDPOINT = credentials('ELASTIC_CLOUD_ENDPOINT')
        ELASTIC_API_KEY = credentials('ELASTIC_API_KEY')
        
        // CI/CD metadata for correlation
        ENVIRONMENT = 'production'
        SERVICE_NAME = 'demo-app'
        
        // Terraform variables
        TF_VAR_app_version = "${env.BUILD_NUMBER}"
        TF_VAR_build_id = "${env.BUILD_ID}"
        TF_VAR_environment = "${ENVIRONMENT}"
        TF_VAR_service_name = "${SERVICE_NAME}"
        TF_VAR_simulated_latency = "${env.SIMULATED_LATENCY ?: '0'}"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    // Handle SCM checkout gracefully - try it, but don't fail if it doesn't work
                    // This allows the pipeline to work both with SCM and with mounted volumes
                    try {
                        checkout scm
                        echo "✓ Checked out from SCM"
                    } catch (Exception e) {
                        echo "⚠ SCM checkout failed (expected if using mounted volumes): ${e.getMessage()}"
                        echo "Continuing with workspace files..."
                    }
                    
                    // Try to capture git metadata if in a git repo
                    def gitCommit = sh(
                        script: 'git rev-parse HEAD 2>/dev/null || echo "no-git"',
                        returnStdout: true
                    ).trim()
                    if (gitCommit != "no-git") {
                        env.GIT_COMMIT = gitCommit
                        env.GIT_COMMIT_SHORT = sh(
                            script: 'git rev-parse --short HEAD',
                            returnStdout: true
                        ).trim()
                        env.GIT_BRANCH = sh(
                            script: 'git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main"',
                            returnStdout: true
                        ).trim()
                    } else {
                        env.GIT_COMMIT = "demo-${env.BUILD_ID}"
                        env.GIT_COMMIT_SHORT = "demo"
                        env.GIT_BRANCH = "demo"
                    }
                }
            }
        }

        stage('Setup Tools') {
            steps {
                    script {
                        // Install Python dependencies
                        sh '''
                            python3 -m venv venv || true
                            . venv/bin/activate
                            pip install --quiet --upgrade pip
                            pip install --quiet elasticsearch requests
                        '''
                    }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    script {
                        // Run terraform init and capture output
                        def initOutput = sh(
                            script: '''
                                set +e
                                terraform init 2>&1
                                echo $? > /tmp/tfinit.status
                            ''',
                            returnStdout: true
                        )
                        
                        // Get exit status
                        def initStatus = sh(
                            script: 'cat /tmp/tfinit.status',
                            returnStdout: true
                        ).trim().toInteger()
                        
                        // Send raw init logs to Elasticsearch
                        // Write output to temp file and use script directly
                        writeFile file: '/tmp/tfinit_output.txt', text: initOutput
                        sh '''
                            . ../venv/bin/activate
                            # We are in terraform/ dir, go back to root to find utils
                            cd ..
                            cat /tmp/tfinit_output.txt | python3 utils/send_raw_logs.py output init
                        '''
                        
                        if (initStatus != 0) {
                            error("Terraform init failed")
                        }
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    script {
                        // Run terraform plan and capture output
                        def planOutput = sh(
                            script: '''
                                terraform plan -out=tfplan \
                                    -var "app_version=${TF_VAR_app_version}" \
                                    -var "build_id=${TF_VAR_build_id}" \
                                    -var "environment=${TF_VAR_environment}" \
                                    -var "service_name=${TF_VAR_service_name}" \
                                    -var "simulated_latency=${TF_VAR_simulated_latency}" 2>&1
                            ''',
                            returnStdout: true
                        )
                        
                        // Send plan output to Elasticsearch
                        // Write output to temp file and use script directly
                        writeFile file: '/tmp/tfplan_output.txt', text: planOutput
                        sh '''
                            . ../venv/bin/activate
                            cd ..
                            cat /tmp/tfplan_output.txt | python3 utils/send_raw_logs.py output plan
                        '''
                        
                        // Export plan as JSON and send
                        sh '''
                            terraform show -json tfplan > ../tfplan.json
                            . ../venv/bin/activate
                            python3 ../utils/send_raw_logs.py plan-json ../tfplan.json
                        '''
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    script {
                        // Run terraform apply and capture output
                        def applyOutput = sh(
                            script: 'terraform apply -auto-approve tfplan 2>&1',
                            returnStdout: true
                        )
                        
                        // Send apply output to Elasticsearch
                        // Write output to temp file and use script directly
                        writeFile file: '/tmp/tfapply_output.txt', text: applyOutput
                        sh '''
                            . ../venv/bin/activate
                            cd ..
                            cat /tmp/tfapply_output.txt | python3 utils/send_raw_logs.py output apply
                        '''
                        
                        // Capture terraform outputs
                        def tfOutput = sh(
                            script: 'terraform output -json',
                            returnStdout: true
                        )
                        
                        // Send terraform outputs to Elasticsearch
                        // Write to file and use script directly
                        writeFile file: '/tmp/tfoutput.txt', text: tfOutput
                        sh '''
                            . ../venv/bin/activate
                            cd ..
                            cat /tmp/tfoutput.txt | python3 utils/send_raw_logs.py output output
                        '''
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    // Wait a moment for app to start
                    sleep(time: 5, unit: 'SECONDS')
                    
                    // Simple health check
                    sh '''
                        curl -f http://localhost:5000/ || echo "App not yet ready"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                // Send pipeline completion metadata
                def status = currentBuild.result ?: 'SUCCESS'
                def duration = currentBuild.duration ?: 0
                def jobName = env.JOB_NAME ?: 'unknown'
                def buildId = env.BUILD_ID ?: 'unknown'
                
                // Write metadata to temp file to avoid string escaping issues
                def completionData = [
                    pipeline: jobName,
                    build: buildId,
                    status: status,
                    duration_ms: duration
                ]
                writeFile file: '/tmp/pipeline_completion.json', text: groovy.json.JsonOutput.toJson(completionData)
                
                sh """
                    . venv/bin/activate
                    # Use WORKSPACE variable
                    # We are in root workspace here
                    python3 -c "
import os
import sys
import json

# Use relative path
sys.path.insert(0, 'utils')
try:
    from send_raw_logs import send_raw_log
    
    with open('/tmp/pipeline_completion.json', 'r') as f:
        data = json.load(f)
    
    metadata = {
        'ci.pipeline.status': '${status}',
        'ci.pipeline.duration': '${duration}',
    }
    
    send_raw_log(
        log_content=json.dumps(data, indent=2),
        log_type='pipeline_completion',
        metadata=metadata
    )
except ImportError as e:
    print(f'Warning: Could not import send_raw_logs: {e}', file=sys.stderr)
    print('Pipeline completion log not sent to Elasticsearch', file=sys.stderr)
"
                """
            }
        }
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
